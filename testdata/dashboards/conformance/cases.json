[
  {"name": "the corrected worked example", "file": "worked-example.json", "expect": null},
  {"name": "members out of order and unknown keys", "file": "unknown-keys-member-order.json", "expect": null},
  {"name": "canvas period and scope", "file": "canvas-period-and-scope.json", "expect": null},
  {"name": "the smallest dashboard",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": []}]}",
   "expect": null},
  {"name": "an empty canvas with no widget list",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"empty\", \"title\": \"Empty\"}]}",
   "expect": null},
  {"name": "a bare shape and a type with its shape",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"s\", \"shape\": \"figure\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 3, \"h\": 2}, \"parameters\": {\"dataset\": \"flow\"}}, {\"id\": \"t\", \"type\": \"top_sites\", \"shape\": \"table\", \"placement\": {\"x\": 3, \"y\": 0, \"w\": 3, \"h\": 2}}]}]}",
   "expect": null},
  {"name": "a whole number written with a fraction",
   "text": "{\"format_version\": 1.0, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 2.0, \"y\": 0, \"w\": 6, \"h\": 1e1}}]}]}",
   "expect": null},
  {"name": "null optional members",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"scope\": null, \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"parameters\": null, \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4}}]}]}",
   "expect": null},

  {"name": "not JSON", "text": "{\"format_version\": 1, \"canvases\": [",
   "expect": {"condition": "malformed_body", "canvas_index": null, "widget_index": null, "field": "", "path": ""}},
  {"name": "not an object", "text": "[{\"format_version\": 1}]",
   "expect": {"condition": "malformed_body", "canvas_index": null, "widget_index": null, "field": "", "path": ""}},
  {"name": "data after the document",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]} {}",
   "expect": {"condition": "malformed_body", "canvas_index": null, "widget_index": null, "field": "", "path": ""}},
  {"name": "a document above 1 MiB",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}", "pad_to_bytes": 1048577,
   "expect": {"condition": "document_too_large", "canvas_index": null, "widget_index": null, "field": "", "path": ""}},
  {"name": "a document of exactly 1 MiB",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}", "pad_to_bytes": 1048576,
   "expect": null},

  {"name": "no format version", "text": "{\"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}",
   "expect": {"condition": "format_version_missing", "canvas_index": null, "widget_index": null,
              "field": "format_version", "path": "format_version"}},
  {"name": "a format version that is a string", "text": "{\"format_version\": \"1\", \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}",
   "expect": {"condition": "format_version_missing", "canvas_index": null, "widget_index": null,
              "field": "format_version", "path": "format_version"}},
  {"name": "a newer format version", "text": "{\"format_version\": 2, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}",
   "expect": {"condition": "format_version_too_new", "canvas_index": null, "widget_index": null,
              "field": "format_version", "path": "format_version", "file_version": 2, "current": 1, "minimum": 1}},
  {"name": "an older format version", "text": "{\"format_version\": 0, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}]}",
   "expect": {"condition": "format_version_too_old", "canvas_index": null, "widget_index": null,
              "field": "format_version", "path": "format_version", "file_version": 0, "current": 1, "minimum": 1}},

  {"name": "no canvases", "text": "{\"format_version\": 1, \"title\": \"Nothing\"}",
   "expect": {"condition": "canvases_missing", "canvas_index": null, "widget_index": null, "field": "canvases", "path": "canvases"}},
  {"name": "canvases that are not a list", "text": "{\"format_version\": 1, \"canvases\": {\"id\": \"c\"}}",
   "expect": {"condition": "canvases_missing", "canvas_index": null, "widget_index": null, "field": "canvases", "path": "canvases"}},
  {"name": "an empty canvas list", "text": "{\"format_version\": 1, \"canvases\": []}",
   "expect": {"condition": "canvases_empty", "canvas_index": null, "widget_index": null, "field": "canvases", "path": "canvases"}},

  {"name": "a canvas with no id",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\"}, {\"title\": \"No id\"}]}",
   "expect": {"condition": "canvas_id_missing", "canvas_index": 1, "widget_index": null, "field": "id", "path": "canvases[1].id"}},
  {"name": "a canvas that is not an object", "text": "{\"format_version\": 1, \"canvases\": [\"main\"]}",
   "expect": {"condition": "canvas_id_missing", "canvas_index": 0, "widget_index": null, "field": "id", "path": "canvases[0].id"}},
  {"name": "a canvas id that is not a slug",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"Main Floor\", \"title\": \"Main floor\"}]}",
   "expect": {"condition": "canvas_id_malformed", "canvas_index": 0, "widget_index": null, "field": "id", "path": "canvases[0].id"}},
  {"name": "a canvas with no title", "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"widgets\": []}]}",
   "expect": {"condition": "canvas_title_missing", "canvas_index": 0, "widget_index": null, "field": "title", "path": "canvases[0].title"}},
  {"name": "two canvases with one id",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"One\"}, {\"id\": \"c\", \"title\": \"Two\"}]}",
   "expect": {"condition": "duplicate_id", "canvas_index": 1, "widget_index": null, "field": "id", "path": "canvases[1].id"}},
  {"name": "a widget list that is not a list",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": {\"id\": \"w\"}}]}",
   "expect": {"condition": "malformed_body", "canvas_index": 0, "widget_index": null, "field": "widgets", "path": "canvases[0].widgets"}},
  {"name": "a scope that is not an object",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"scope\": [\"opt3\"]}]}",
   "expect": {"condition": "malformed_body", "canvas_index": 0, "widget_index": null, "field": "scope", "path": "canvases[0].scope"}},
  {"name": "a scope nested too deep",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"scope\": {\"interfaces\": [{\"kind\": \"interface\", \"by\": \"identifier\", \"value\": {\"a\": {\"b\": 1}}}]}}]}",
   "expect": {"condition": "nesting_too_deep", "canvas_index": 0, "widget_index": null, "field": "a", "path": "canvases[0].scope.interfaces[0].value.a"}},

  {"name": "a widget with no id",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4}}, {\"type\": \"top_sites\", \"placement\": {\"x\": 6, \"y\": 0, \"w\": 6, \"h\": 4}}]}]}",
   "expect": {"condition": "widget_id_missing", "canvas_index": 0, "widget_index": 1, "field": "id", "path": "canvases[0].widgets[1].id"}},
  {"name": "a widget that is not an object",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [7]}]}",
   "expect": {"condition": "widget_id_missing", "canvas_index": 0, "widget_index": 0, "field": "id", "path": "canvases[0].widgets[0].id"}},
  {"name": "two widgets with one id",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4}}, {\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 6, \"y\": 0, \"w\": 6, \"h\": 4}}]}]}",
   "expect": {"condition": "duplicate_id", "canvas_index": 0, "widget_index": 1, "field": "id", "path": "canvases[0].widgets[1].id"}},
  {"name": "a widget with neither type nor shape",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"title\": \"What?\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4}}]}]}",
   "expect": {"condition": "widget_type_and_shape_missing", "canvas_index": 0, "widget_index": 0, "field": "type", "path": "canvases[0].widgets[0].type"}},
  {"name": "a widget with no placement",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\"}]}]}",
   "expect": {"condition": "placement_missing", "canvas_index": 0, "widget_index": 0, "field": "placement", "path": "canvases[0].widgets[0].placement"}},
  {"name": "a placement with no height",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6}}]}]}",
   "expect": {"condition": "placement_missing", "canvas_index": 0, "widget_index": 0, "field": "h", "path": "canvases[0].widgets[0].placement.h"}},
  {"name": "a placement with a fraction",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 2.5, \"h\": 4}}]}]}",
   "expect": {"condition": "placement_not_integer", "canvas_index": 0, "widget_index": 0, "field": "w", "path": "canvases[0].widgets[0].placement.w"}},
  {"name": "a placement with a string",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": \"0\", \"y\": 0, \"w\": 6, \"h\": 4}}]}]}",
   "expect": {"condition": "placement_not_integer", "canvas_index": 0, "widget_index": 0, "field": "x", "path": "canvases[0].widgets[0].placement.x"}},
  {"name": "a negative placement",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": -1, \"w\": 6, \"h\": 4}}]}]}",
   "expect": {"condition": "placement_not_integer", "canvas_index": 0, "widget_index": 0, "field": "y", "path": "canvases[0].widgets[0].placement.y"}},
  {"name": "parameters that are not an object",
   "text": "{\"format_version\": 1, \"canvases\": [{\"id\": \"c\", \"title\": \"C\", \"widgets\": [{\"id\": \"w\", \"type\": \"top_sites\", \"placement\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4}, \"parameters\": [\"24h\"]}]}]}",
   "expect": {"condition": "malformed_body", "canvas_index": 0, "widget_index": 0, "field": "parameters", "path": "canvases[0].widgets[0].parameters"}},
  {"name": "a series reference nested too deep", "file": "parameters-too-deep.json",
   "expect": {"condition": "nesting_too_deep", "canvas_index": 0, "widget_index": 0, "field": "value",
              "path": "canvases[0].widgets[0].parameters.series[0].interface.value"}},
  {"name": "the first defect in document order wins", "file": "first-defect-wins.json",
   "expect": {"condition": "placement_not_integer", "canvas_index": 1, "widget_index": 1, "field": "y",
              "path": "canvases[1].widgets[1].placement.y"}}
]
