{{- /*
  The Interfaces surface: one card per interface, its networks and its link-local
  rule.

  ONE CARD PER INTERFACE ROW, in the order the store returns them, which is the
  order discovery first stored them and interprets no name. The card's heading is
  the description entered in OPNsense; its identifier and its device are beside it.
  All three are discovered data and are drawn as data, untranslated.

  AN UPSTREAM CARD CARRIES NO CONTROL. A gateway sits behind it, and an address
  reached through it is outside: on-link evidence there is not evidence, so the card
  says it is upstream and offers nothing to set.

  EVERY OTHER CARD LISTS EVERY STORED NETWORK, of both families, with its origin,
  whether it is removed and whether it counts now -- the three facts decision D1
  reads -- and, beside a "no", why: removed by the operator, or no longer detected.
  Each row carries the controls its state allows, one network at a time: confirm a
  detected network, remove one in place, restore one removed. A removed network
  stays listed, which is what makes its removal undoable. A card with no stored
  network names that state rather than drawing an empty table.

  OVERLAPS ARE A STATE OF THE CARD, read on every draw: each counting network of this
  interface that overlaps a counting network of another, with that network and its
  interface. They are not refusals, and they stay listed on both cards until the
  operator resolves them.

  EVERY FORM POSTS TO ITS CARD'S ANCHOR. A saved edit returns to the card, which
  says it was saved; a refused range is put back in the field, marked aria-invalid,
  pointed at its refusal by aria-describedby, and given the focus.

  ON A NARROW SCREEN A TABLE STACKS. Each cell carries its column's name in a
  data-label attribute, from the catalogue, and below the narrow breakpoint the
  stylesheet draws every row as a block of labelled lines, so whether a network
  counts, why not, its controls and the other interface's name stay on screen
  rather than behind a sideways scroll.

  AN EDIT IS SAVED FOR THE NEXT DERIVATION, and the notice says no more than that.
  Nothing here writes to the firewall.
*/ -}}
{{define "body" -}}
<h1>{{t "interfaces.title"}}</h1>
{{- if not .Interfaces}}
<p class="empty-state">{{t "state.interface.none"}}</p>
{{- end}}
{{- range .Interfaces}}
{{- $card := .}}
<section class="card" id="interface_{{.ID}}" aria-labelledby="interface_name_{{.ID}}">
<h2 id="interface_name_{{.ID}}"><span class="datum" translate="no">{{.Description}}</span></h2>
{{- with .NoticeKey}}
<p class="notice ok">{{t .}}</p>
{{- end}}
<dl class="states">
<dt>{{t "interfaces.label.identifier"}}</dt>
<dd><span class="datum" translate="no">{{.Identifier}}</span></dd>
<dt>{{t "interfaces.label.device"}}</dt>
<dd><span class="datum" translate="no">{{.Device}}</span></dd>
<dt>{{t "interfaces.label.upstream"}}</dt>
<dd>{{t .UpstreamKey}}</dd>
</dl>
{{- if not .Upstream}}

<h3>{{t "interfaces.heading.networks"}}</h3>
{{- if .Networks}}
<div class="table-frame">
<table class="data stack">
<thead>
<tr><th scope="col">{{t "interfaces.column.network"}}</th><th scope="col">{{t "interfaces.column.origin"}}</th><th scope="col">{{t "interfaces.column.removed"}}</th><th scope="col">{{t "interfaces.column.counts"}}</th><th scope="col">{{t "interfaces.column.action"}}</th></tr>
</thead>
<tbody>
{{- range .Networks}}
<tr>
<td class="network" data-label="{{t "interfaces.column.network"}}"><span class="datum" translate="no">{{.Network}}</span></td>
<td data-label="{{t "interfaces.column.origin"}}">{{t .OriginKey}}</td>
<td data-label="{{t "interfaces.column.removed"}}">{{t .RemovedKey}}</td>
<td data-label="{{t "interfaces.column.counts"}}">{{t .CountsKey}}{{with .ReasonKey}}<span class="counts-reason">{{t .}}</span>{{end}}</td>
<td class="row-actions" data-label="{{t "interfaces.column.action"}}">
{{- if .CanConfirm}}
<form method="post" action="{{$.InterfacesPath}}#interface_{{$card.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="{{$.FieldInterfaceID}}" value="{{$card.ID}}">
<input type="hidden" name="{{$.FieldNetwork}}" value="{{.Network}}">
<button type="submit" name="{{$.FieldNetworkAction}}" value="confirm" class="secondary">{{t "action.confirm"}}</button>
</form>
{{- end}}
{{- if .CanRemove}}
<form method="post" action="{{$.InterfacesPath}}#interface_{{$card.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="{{$.FieldInterfaceID}}" value="{{$card.ID}}">
<input type="hidden" name="{{$.FieldNetwork}}" value="{{.Network}}">
<button type="submit" name="{{$.FieldNetworkAction}}" value="remove" class="secondary">{{t "action.remove"}}</button>
</form>
{{- end}}
{{- if .CanRestore}}
<form method="post" action="{{$.InterfacesPath}}#interface_{{$card.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="{{$.FieldInterfaceID}}" value="{{$card.ID}}">
<input type="hidden" name="{{$.FieldNetwork}}" value="{{.Network}}">
<button type="submit" name="{{$.FieldNetworkAction}}" value="restore" class="secondary">{{t "action.restore"}}</button>
</form>
{{- end}}
</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p class="empty-state">{{t "state.interface.no_network"}}</p>
{{- end}}
{{- if .Overlaps}}

<h3>{{t "interfaces.heading.overlaps"}}</h3>
<div class="table-frame">
<table class="data overlaps stack">
<thead>
<tr><th scope="col">{{t "interfaces.column.network"}}</th><th scope="col">{{t "interfaces.column.overlapping"}}</th><th scope="col">{{t "interfaces.column.interface"}}</th></tr>
</thead>
<tbody>
{{- range .Overlaps}}
<tr>
<td class="network" data-label="{{t "interfaces.column.network"}}"><span class="datum" translate="no">{{.Network}}</span></td>
<td class="network" data-label="{{t "interfaces.column.overlapping"}}"><span class="datum" translate="no">{{.Other}}</span></td>
<td data-label="{{t "interfaces.column.interface"}}"><span class="datum" translate="no">{{.Description}}</span></td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}

<form method="post" action="{{$.InterfacesPath}}#interface_{{.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="{{$.FieldInterfaceID}}" value="{{.ID}}">
{{- if .RefusalKey}}
<div class="field invalid">
<label for="network_{{.ID}}">{{t "field.network"}}</label>
<input id="network_{{.ID}}" name="{{$.FieldNetwork}}" type="text" autocomplete="off" spellcheck="false" value="{{.Typed}}" aria-invalid="true" aria-describedby="network_refusal_{{.ID}}" autofocus>
<p class="field-refusal" id="network_refusal_{{.ID}}">{{t .RefusalKey}}</p>
</div>
{{- else}}
<div class="field">
<label for="network_{{.ID}}">{{t "field.network"}}</label>
<input id="network_{{.ID}}" name="{{$.FieldNetwork}}" type="text" autocomplete="off" spellcheck="false">
</div>
{{- end}}
<div class="actions">
<button type="submit" name="{{$.FieldNetworkAction}}" value="add">{{t "action.add"}}</button>
</div>
</form>

<form method="post" action="{{$.InterfacesPath}}#interface_{{.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="{{$.FieldInterfaceID}}" value="{{.ID}}">
<div class="field">
<label for="link_local_{{.ID}}">{{t "field.link_local"}}</label>
<select id="link_local_{{.ID}}" name="{{$.FieldLinkLocal}}">
{{- range .LinkLocal}}
<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{t .LabelKey}}</option>
{{- end}}
</select>
</div>
<div class="actions">
<button type="submit" name="{{$.FieldNetworkAction}}" value="link_local">{{t "action.save"}}</button>
</div>
</form>
{{- end}}
</section>
{{- end}}
{{- end}}
