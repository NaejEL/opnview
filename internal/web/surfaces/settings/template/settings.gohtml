{{- /*
  The settings surface: where credentials enter the product.

  ONE CARD PER SUBJECT, angular at the 0.25rem radius — the layout
  docs/ui-references.md's General layout row records. Each card carries its fields
  and the state of what is stored beside them; none of them carries a sentence of
  explanation, and if a field turns out to need one, the field is wrong and that is
  a finding for the next cycle rather than a licence to add copy.

  A SECRET FIELD IS NEVER PRE-FILLED. The API secret and the MaxMind licence key
  render empty whatever is stored, and an empty submission LEAVES THE STORED VALUE
  ALONE rather than clearing it — otherwise saving the theme would destroy the
  credentials. What is stored is reported as a STATE beside the field, which is the
  only thing about a secret this surface may say.

  THE FIREWALL URL AND THE API KEY ARE PRE-FILLED, because they are configuration
  rather than secrets and a reader correcting a typo has to be able to see the typo.

  THE FINGERPRINT IS FILLED BY A BUTTON AND NOT BY THE READER. Asking somebody to
  go and find a 64-character hash somewhere else, for a certificate opnview is
  already holding, is asking them to fetch what the program has. The button
  connects, shows what was presented, and stores NOTHING: accepting it is the save
  that follows, which is a second deliberate act. The field stays typeable for
  whoever wants to compare against the source rather than trust the first
  connection.

  THE PUBLIC SUFFIX LIST'S CARD SITS BESIDE GEOLOCATION, in the same form as the
  MaxMind state: the last refresh's outcome from the availability row, and the
  copy's figures from the process that holds it. A failed refresh over a copy still
  in use shows both. Its refresh interval is a duration field, shown once, in the
  field; drawing the card contacts nothing.

  ONE FORM FOR THE PAGE, ONE SAVE PER CARD. Every field belongs to one form, and
  each card's Save sends that card's name: the card named is stored and the others
  come back as they were typed, marked edited and not saved, so saving one card
  never discards what was typed in another. A secret typed and not stored says so
  beside its field, since a secret field is never filled. The form's first button,
  the one the Enter key presses, names no card and stores nothing. What a save did
  or refused is said inside the card it was made in, each Save posting to its own
  card's anchor so the answer is in view.

  NOTHING HERE WRITES TO THE FIREWALL. There is no control on this page that could,
  and the API client refuses a mutating command before a request exists.
*/ -}}
{{define "body" -}}
<h1>{{t "settings.title"}}</h1>
<form method="post" action="{{.SettingsPath}}" class="page-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">{{t "action.save"}}</button>

<section class="card" id="settings_firewall" aria-labelledby="settings_firewall_name">
<h2 id="settings_firewall_name">{{t "settings.heading.firewall"}}</h2>
{{- if eq .SettingsCard "firewall"}}
{{- with .Notice}}
<p class="notice ok">{{t .}}</p>
{{- end}}
{{- with .Error}}
<p class="notice bad">{{t .}}</p>
{{- end}}
{{- else if index .SettingsEdited "firewall"}}
<p class="notice">{{t "notice.edited_not_saved"}}</p>
{{- end}}
<div class="field">
<label for="firewall_url">{{t "field.firewall_url"}}</label>
<input id="firewall_url" name="firewall_url" type="url" autocomplete="off" spellcheck="false" value="{{.FirewallURL}}">
</div>
<div class="field">
<label for="certificate_fingerprint">{{t "field.certificate_fingerprint"}}</label>
<input id="certificate_fingerprint" name="certificate_fingerprint" type="text" autocomplete="off" spellcheck="false" value="{{.CertificateFingerprint}}">
<div class="actions beside-field">
<button type="submit" name="fetch_certificate" value="1" formaction="{{.SettingsPath}}#settings_firewall" class="secondary">{{t "action.fetch_certificate"}}</button>
</div>
</div>
<div class="field">
<label for="api_key">{{t "field.api_key"}}</label>
<input id="api_key" name="api_key" type="text" autocomplete="off" spellcheck="false" value="{{.APIKey}}">
</div>
<div class="field">
<label for="api_secret">{{t "field.api_secret"}}</label>
<input id="api_secret" name="api_secret" type="password" autocomplete="off"{{if .APISecretNotKept}} aria-describedby="api_secret_state"{{end}}>
{{- if .APISecretNotKept}}
<p class="field-state" id="api_secret_state">{{t "state.secret_not_kept"}}</p>
{{- end}}
</div>
<dl class="states">
<dt>{{t "settings.label.credential_state"}}</dt>
<dd>{{t .CredentialState}}</dd>
<dt>{{t "settings.label.verification"}}</dt>
<dd>{{t .VerificationState}}</dd>
</dl>
<div class="actions">
<button type="submit" name="settings_card" value="firewall" formaction="{{.SettingsPath}}#settings_firewall">{{t "action.save"}}</button>
</div>
</section>

<section class="card" id="settings_geolocation" aria-labelledby="settings_geolocation_name">
<h2 id="settings_geolocation_name">{{t "settings.heading.geolocation"}}</h2>
{{- if eq .SettingsCard "geolocation"}}
{{- with .Notice}}
<p class="notice ok">{{t .}}</p>
{{- end}}
{{- with .Error}}
<p class="notice bad">{{t .}}</p>
{{- end}}
{{- else if index .SettingsEdited "geolocation"}}
<p class="notice">{{t "notice.edited_not_saved"}}</p>
{{- end}}
<div class="field">
<label for="maxmind_licence_key">{{t "field.maxmind_licence_key"}}</label>
<input id="maxmind_licence_key" name="maxmind_licence_key" type="password" autocomplete="off"{{if .LicenceKeyNotKept}} aria-describedby="maxmind_licence_key_state"{{end}}>
{{- if .LicenceKeyNotKept}}
<p class="field-state" id="maxmind_licence_key_state">{{t "state.secret_not_kept"}}</p>
{{- end}}
</div>
<div class="field">
<label for="maxmind_account_id">{{t "field.maxmind_account_id"}}</label>
<input id="maxmind_account_id" name="maxmind_account_id" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" value="{{.MaxMindAccountID}}">
</div>
<dl class="states">
<dt>{{t "settings.label.maxmind_licence_key_state"}}</dt>
<dd>{{t .LicenceKeyState}}</dd>
<dt>{{t "settings.label.geoip_state"}}</dt>
<dd>{{t .GeoIPState}}</dd>
{{- with .GeoIPBuild}}
<dt>{{t "settings.label.geoip_build"}}</dt>
<dd><span class="figure">{{.}}</span></dd>
{{- end}}
</dl>
<div class="actions">
<button type="submit" name="settings_card" value="geolocation" formaction="{{.SettingsPath}}#settings_geolocation">{{t "action.save"}}</button>
</div>
</section>

<section class="card" id="settings_public_suffix" aria-labelledby="settings_public_suffix_name">
<h2 id="settings_public_suffix_name">{{t "collection.kind.registrable_domain"}}</h2>
{{- if eq .SettingsCard "public_suffix"}}
{{- with .Notice}}
<p class="notice ok">{{t .}}</p>
{{- end}}
{{- with .Error}}
<p class="notice bad">{{t .}}</p>
{{- end}}
{{- else if index .SettingsEdited "public_suffix"}}
<p class="notice">{{t "notice.edited_not_saved"}}</p>
{{- end}}
<dl class="states">
<dt>{{t "settings.label.public_suffix_state"}}</dt>
<dd>{{t .PublicSuffix.StateKey}}</dd>
<dt>{{t "settings.label.public_suffix_in_use"}}</dt>
<dd>{{t .PublicSuffix.InUseKey}}</dd>
<dt>{{t "settings.label.public_suffix_confirmed"}}</dt>
<dd>{{if .PublicSuffix.ConfirmedState}}{{t .PublicSuffix.ConfirmedState}}{{else}}<span class="figure">{{.PublicSuffix.Confirmed}}</span>{{end}}</dd>
{{- if .PublicSuffix.InUse}}
<dt>{{t "settings.label.public_suffix_version"}}</dt>
<dd>{{if .PublicSuffix.VersionState}}{{t .PublicSuffix.VersionState}}{{else}}<span class="datum" translate="no">{{.PublicSuffix.Version}}</span>{{end}}</dd>
<dt>{{t "settings.label.public_suffix_rules"}}</dt>
<dd><span class="figure">{{.PublicSuffix.Rules}}</span></dd>
{{- end}}
</dl>
{{- template "setting-field" .PublicSuffix.IntervalField}}
<div class="actions">
<button type="submit" name="settings_card" value="public_suffix" formaction="{{.SettingsPath}}#settings_public_suffix">{{t "action.save"}}</button>
</div>
</section>

<section class="card" id="settings_appearance" aria-labelledby="settings_appearance_name">
<h2 id="settings_appearance_name">{{t "settings.heading.appearance"}}</h2>
{{- if eq .SettingsCard "appearance"}}
{{- with .Notice}}
<p class="notice ok">{{t .}}</p>
{{- end}}
{{- with .Error}}
<p class="notice bad">{{t .}}</p>
{{- end}}
{{- else if index .SettingsEdited "appearance"}}
<p class="notice">{{t "notice.edited_not_saved"}}</p>
{{- end}}
<div class="field">
<label for="theme">{{t "field.theme"}}</label>
<select id="theme" name="theme">
{{- range .Themes}}
<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{t .Label}}</option>
{{- end}}
</select>
</div>
<div class="actions">
<button type="submit" name="settings_card" value="appearance" formaction="{{.SettingsPath}}#settings_appearance">{{t "action.save"}}</button>
</div>
</section>
</form>
{{- end}}
