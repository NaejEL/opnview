    {"name": "action", "type": "text"},
    {"name": "rcode", "type": "text", "nullable": true},
    {"name": "client_id", "type": "integer", "nullable": true},
    {"name": "interface", "type": "text", "nullable": true},
    {"name": "lookups", "type": "integer", "role": "measure", "unit": "lookup", "aggregations": ["sum", "count"]},
    {"name": "blocked", "type": "integer", "role": "measure", "unit": "lookup", "aggregations": ["sum"]}
  ]
}
