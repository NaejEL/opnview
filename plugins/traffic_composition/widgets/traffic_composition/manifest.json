{
  "manifest_version": 1,
  "type": "traffic_composition",
  "shape": "donut",
  "providers": [
    "firewall_log",
    "measurement_sample"
  ],
  "primary": "firewall_log",
  "windowed": true,
  "no_domains": "none",
  "lower_bound": true,
  "parameters": [
    {
      "key": "period",
      "kind": "enum",
      "values": [
        "1h",
        "24h",
        "7d",
        "30d"
      ],
      "default": "24h",
      "class": "data"
    },
    {
      "key": "group_by",
      "kind": "enum",
      "values": [
        "client",
        "interface",
        "protocol",
        "service_port"
      ],
      "default": "interface",
      "class": "data"
    },
    {
      "key": "measure",
      "kind": "enum",
      "values": [
        "bytes",
        "connections"
      ],
      "default": "bytes",
      "class": "data"
    },
    {
      "key": "slices",
      "kind": "integer",
      "default": 6,
      "min": 1,
      "class": "data"
    },
    {
      "key": "interfaces",
      "kind": "reference_list",
      "default": null,
      "reference": "interface",
      "class": "data"
    },
    {
      "key": "clients",
      "kind": "reference_list",
      "default": null,
      "reference": "client",
      "class": "data"
    },
    {
      "key": "scope",
      "kind": "enum",
      "values": [
        "all",
        "east_west",
        "north_south"
      ],
      "default": "all",
      "class": "data"
    },
    {
      "key": "show_other",
      "kind": "boolean",
      "default": true,
      "class": "rendering"
    }
  ],
  "references": [
    "client",
    "interface"
  ],
  "queries": [
    "traffic_composition.statements.sql"
  ],
  "script": "traffic_composition.js",
  "renderer": {
    "reserved": true
  }
}
