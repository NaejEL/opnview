{
  "manifest_version": 1,
  "type": "traffic_composition",
  "shape": "donut",
  "providers": [
    "firewall_log",
    "measurement_sample"
  ],
  "primary": "firewall_log",
  "windowed": true,
  "no_domains": "none",
  "lower_bound": true,
  "volumes": true,
  "parameters": [
    {
      "key": "period",
      "kind": "enum",
      "values": [
        "1h",
        "24h",
        "7d",
        "30d"
      ],
      "default": "24h",
      "class": "data"
    },
    {
      "key": "group_by",
      "kind": "enum",
      "values": [
        "client",
        "interface",
        "protocol",
        "service_port",
        "blocking_reason"
      ],
      "default": "interface",
      "class": "data"
    },
    {
      "key": "measure",
      "kind": "enum",
      "values": [
        "bytes",
        "connections"
      ],
      "default": "bytes",
      "class": "data"
    },
    {
      "key": "slices",
      "kind": "integer",
      "default": 6,
      "min": 1,
      "class": "data"
    },
    {
      "key": "interfaces",
      "kind": "reference_list",
      "default": null,
      "reference": "interface",
      "class": "data"
    },
    {
      "key": "clients",
      "kind": "reference_list",
      "default": null,
      "reference": "client",
      "class": "data"
    },
    {
      "key": "scope",
      "kind": "enum",
      "values": [
        "all",
        "east_west",
        "north_south"
      ],
      "default": "all",
      "class": "data"
    },
    {
      "key": "split_by",
      "kind": "enum",
      "values": [
        "none",
        "direction"
      ],
      "default": "none",
      "class": "data"
    },
    {
      "key": "window_seconds",
      "kind": "integer",
      "default": null,
      "min": 2,
      "max": 3600,
      "class": "data"
    },
    {
      "key": "show_other",
      "kind": "boolean",
      "default": true,
      "class": "rendering"
    },
    {
      "key": "line_interpolation",
      "kind": "enum",
      "values": [
        "points",
        "linear",
        "smooth"
      ],
      "default": "linear",
      "class": "rendering"
    }
  ],
  "references": [
    "client",
    "interface"
  ],
  "queries": [
    "traffic_composition.statements.sql"
  ],
  "script": "traffic_composition.js",
  "renderer": {
    "entry": "renderer.js"
  }
}
