{
  "api_version": 3,
  "name": "insight",
  "version": "2.0.0",
  "display_name": "NetFlow / Insight sampling",
  "description": "Samples the live per-pair traffic snapshot and reads the firewall's own gauges: memory, processor, temperature, uptime, load, disk, interface counters, gateways and swap (data source 3), into its own table of readings; a live pass samples the per-pair snapshot and the counters at the live cadence while somebody looks at a live figure (ADR 0020 wave 4).",
  "script": "insight.js",
  "requires": [
    "installation"
  ],
  "datasets": [
    "interface"
  ],
  "endpoints": [
    {
      "name": "netflow_is_enabled",
      "path": "/api/diagnostics/netflow/is_enabled",
      "method": "GET",
      "survey_section": "Data source 3 — NetFlow / Insight",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/NetflowController.php",
      "note": "Returns {netflow: 0|1, local: 0|1}."
    },
    {
      "name": "traffic_top",
      "path": "/api/diagnostics/traffic/top",
      "method": "GET",
      "argument": "interface_names",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/TrafficController.php",
      "note": "Per interface, a records[] of local addresses with rate_bits_in/out, cumulative_bytes_in/out and a details[] of peers. No port and no protocol. One call runs iftop -s 2 on every interface named, concurrently (scripts/interfaces/traffic_top.py), so no answer is fresher than its 2-second capture: that span is the floor. The floor measured on a live firewall is pending LV-C.",
      "floor_seconds": 2
    },
    {
      "name": "traffic_interface",
      "path": "/api/diagnostics/traffic/interface",
      "method": "GET",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/TrafficController.php",
      "note": "Per-interface counters."
    },
    {
      "name": "system_resources",
      "path": "/api/diagnostics/system/systemResources",
      "method": "GET",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/SystemController.php",
      "note": "Memory figures. Field names not established by the survey."
    },
    {
      "name": "system_temperature",
      "path": "/api/diagnostics/system/systemTemperature",
      "method": "GET",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/SystemController.php",
      "note": "Per-sensor temperatures. Absent on hardware with no sensor, which is a state and not a zero."
    },
    {
      "name": "system_time",
      "path": "/api/diagnostics/system/systemTime",
      "method": "GET",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/SystemController.php",
      "note": "Uptime and load average."
    },
    {
      "name": "system_disk",
      "path": "/api/diagnostics/system/systemDisk",
      "method": "GET",
      "survey_section": "Verified against a live firewall, 2026-09-27",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/SystemController.php",
      "note": "Filesystem usage. Field names not established by the survey."
    },
    {
      "name": "gateway_status",
      "path": "/api/routes/gateway/status",
      "method": "GET",
      "survey_section": "Gateway status, read from source for step 5",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Routes/Api/GatewayController.php",
      "note": "Returns {items: [...], status: ok | failed}; each item carries name, address, status, loss, delay and stddev, or ~ where dpinger has no figure."
    },
    {
      "name": "system_swap",
      "path": "/api/diagnostics/system/systemSwap",
      "method": "GET",
      "survey_section": "Swap, read from source for step 5",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/SystemController.php",
      "note": "Returns {swap: [{device, total, used}]}, total and used as strings in KiB."
    },
    {
      "name": "cpu_usage_stream",
      "path": "/api/diagnostics/cpu_usage/stream",
      "method": "GET",
      "stream": true,
      "survey_section": "Processor stream, read from source for the resolver-cache cycle",
      "upstream_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/controllers/OPNsense/Diagnostics/Api/CpuUsageController.php",
      "note": "text/event-stream, one event about every second and no end; read only with a bound."
    }
  ],
  "settings": [
    {
      "key": "live_cadence_seconds",
      "type": "integer",
      "default": 10,
      "min": 2,
      "max": 300,
      "label": "plugin.insight.setting.live_cadence_seconds"
    }
  ],
  "providers": [
    {
      "kind": "measurement_sample",
      "display_name": "NetFlow / Insight sampling",
      "enable_pages": [
        {
          "path": "/ui/diagnostics/netflow",
          "label": "plugin.insight.opnsense_page.netflow",
          "menu_url": "https://github.com/opnsense/core/blob/26.7.3/src/opnsense/mvc/app/models/OPNsense/Diagnostics/Menu/Menu.xml",
          "note": "Reporting > NetFlow, which holds netflow.collect.enable, the local flag /api/diagnostics/netflow/is_enabled reports (controllers/OPNsense/Diagnostics/forms/netflow_capture.xml)."
        }
      ],
      "read_strategy": "full_reread",
      "live": {
        "function": "live",
        "cadence_setting": "live_cadence_seconds",
        "endpoints": [
          "traffic_top",
          "traffic_interface"
        ]
      }
    }
  ],
  "tables": [
    {
      "name": "measurement_sample",
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "identity": true
        },
        {
          "name": "provider_id",
          "type": "integer",
          "nullable": true
        },
        {
          "name": "subject_kind",
          "type": "text"
        },
        {
          "name": "subject_key",
          "type": "text"
        },
        {
          "name": "interface_device",
          "type": "text",
          "nullable": true
        },
        {
          "name": "local_address",
          "type": "text",
          "nullable": true
        },
        {
          "name": "peer_address",
          "type": "text",
          "nullable": true
        },
        {
          "name": "measure",
          "type": "text"
        },
        {
          "name": "unit",
          "type": "text"
        },
        {
          "name": "value",
          "type": "real"
        },
        {
          "name": "sampled_at",
          "type": "integer"
        },
        {
          "name": "live_cadence_seconds",
          "type": "integer",
          "nullable": true
        }
      ],
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "subject_kind",
            "subject_key",
            "measure",
            "sampled_at",
            "provider_id"
          ],
          "unique": true,
          "nulls_not_distinct": true
        },
        {
          "columns": [
            "subject_kind",
            "subject_key",
            "measure",
            "sampled_at",
            "value"
          ]
        },
        {
          "columns": [
            "sampled_at"
          ]
        },
        {
          "columns": [
            "sampled_at"
          ],
          "where": "live_cadence_seconds IS NOT NULL"
        }
      ],
      "checks": [
        {
          "name": "subject_kind_word",
          "expression": "length(subject_kind) > 0 AND subject_kind = lower(subject_kind) AND strpos(subject_kind, ' ') = 0"
        },
        {
          "name": "interface_device_not_empty",
          "expression": "interface_device IS NULL OR length(interface_device) > 0"
        },
        {
          "name": "local_address_not_empty",
          "expression": "local_address IS NULL OR length(local_address) > 0"
        },
        {
          "name": "peer_address_not_empty",
          "expression": "peer_address IS NULL OR length(peer_address) > 0"
        },
        {
          "name": "measure_word",
          "expression": "length(measure) > 0 AND measure = lower(measure) AND strpos(measure, ' ') = 0"
        },
        {
          "name": "unit_word",
          "expression": "length(unit) > 0 AND unit = lower(unit) AND strpos(unit, ' ') = 0"
        },
        {
          "name": "sampled_at_instant",
          "expression": "sampled_at >= 0 AND sampled_at < 4102444800"
        },
        {
          "name": "live_cadence_positive",
          "expression": "live_cadence_seconds IS NULL OR live_cadence_seconds > 0"
        }
      ]
    }
  ],
  "sample_metrics": [
    {
      "name": "cpu",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "cpu_use_ratio"
      ]
    },
    {
      "name": "disk",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "disk_use_ratio"
      ]
    },
    {
      "name": "gateway_latency",
      "provider_kind": "measurement_sample",
      "subject_kind": "gateway",
      "measures": [
        "delay_milliseconds"
      ]
    },
    {
      "name": "gateway_loss",
      "provider_kind": "measurement_sample",
      "subject_kind": "gateway",
      "measures": [
        "loss_ratio"
      ]
    },
    {
      "name": "memory",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "memory_use_ratio"
      ]
    },
    {
      "name": "swap",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "swap_used_bytes",
        "swap_total_bytes"
      ]
    },
    {
      "name": "temperature",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "temperature_celsius"
      ]
    },
    {
      "name": "uptime",
      "provider_kind": "measurement_sample",
      "subject_kind": "firewall",
      "measures": [
        "uptime_seconds"
      ]
    }
  ]
}
