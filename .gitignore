# Software-factory cycle logs
factory-logs/

# Go binaries
/opnview
/opnview.exe
/bin/
/dist/

# Local SQLite database and runtime data (never in the repository)
*.db
*.db-shm
*.db-wal
/data/

# The encryption key that sits beside the database. It is created on first
# start with permissions denying group and other, it lives in the data
# directory — which is outside the bind-mounted tree in the compose
# environment, exactly as the database is — and it is never committed. A
# database without it is a database whose stored credentials cannot be read,
# which is the whole point of keeping the two apart.
opnview.key

# MaxMind GeoLite2 databases: downloaded at runtime, never versioned
*.mmdb
/geoip/

# Local configuration holding secrets (entered through the web wizard)
config.local.*
.env

# Machine-local Claude Code settings
.claude/settings.local.json

# UI reference screenshots: captured locally from public demos, vendor sites,
# project repositories, blog posts and design galleries, referenced by
# docs/ui-references.md and never committed. Provenance and capture date are
# recorded next to each reference and in that document's complete image index,
# so any reader can go and look; the files themselves do not survive a clone.
docs/ui-references/screenshots/

# Probe output: raw API responses from a real firewall. Never committed —
# they carry that installation's addresses, hostnames, MAC addresses and
# interface labels.
opnsense-probe*/
dig.json
