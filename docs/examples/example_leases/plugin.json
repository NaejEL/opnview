{
  "api_version": 3,
  "name": "example_leases",
  "version": "1.0.0",
  "display_name": "Example leases",
  "description": "Reads the lease table of an example DHCP server into the leases plugin's table, with no line of code.",
  "requires": ["leases"],
  "endpoints": [
    { "name": "status", "path": "/api/exampledhcp/service/status", "method": "GET" },
    { "name": "leases", "path": "/api/exampledhcp/leases/search", "method": "POST", "body": "form" }
  ],
  "providers": [
    {
      "kind": "dhcp_lease",
      "display_name": "Example leases",
      "read_strategy": "full_reread",
      "probe": { "endpoint": "status", "check": "service_running" },
      "read": {
        "endpoint": "leases",
        "paginate": true,
        "table": "leases.dhcp_lease",
        "fields": {
          "provider_id": { "as": "provider_id" },
          "backend": { "as": "provider_key" },
          "address": "address",
          "mac": { "from": "hwaddr", "as": "mac" },
          "hostname": "hostname",
          "lease_state": { "value": "active" },
          "expires_at": { "from": "expire", "as": "epoch" },
          "observed_at": { "as": "now" }
        }
      }
    }
  ]
}
